# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "OCaml bindings to WebGPU through wgpu-native"
description: """
Bindings to the WebGPU C API (webgpu.h) and the wgpu-native extensions
(wgpu.h), generated from the vendored upstream headers and bound with
ctypes-foreign.  libwgpu_native is loaded dynamically at run time; no C stubs
are compiled and no headers are needed at build time.

This package is entirely AI-authored; see the README for details."""
maintainer: ["caduc-ai <ai@caduc.co>"]
authors: ["AI agents (human owner: lloyd-g-w)"]
tags: ["webgpu" "wgpu" "graphics" "gpu" "bindings"]
homepage: "https://github.com/lloyd-g-w/wgpu-ocaml"
bug-reports: "https://github.com/lloyd-g-w/wgpu-ocaml/issues"
depends: [
  "ocaml" {>= "5.2.0"}
  "dune" {>= "3.20" & >= "3.20"}
  "ctypes" {>= "0.23.0"}
  "ctypes-foreign" {>= "0.23.0"}
  "integers" {>= "0.7.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lloyd-g-w/wgpu-ocaml.git"
x-maintenance-intent: ["(latest)"]
